<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>개인 프로필</title>
  <style>
    body {
      font-family: 'Malgun Gothic', sans-serif;
      color: #000000;
      text-align: center;
      margin: 40px auto;
      line-height: 1.8;
      font-size: 16px;
    }

    h1 {
      font-size: 28px;
      color: #000000;
      margin-bottom: 24px;
      font-weight: bold;
    }

    h1 span {
      background: linear-gradient(to top, #ffed85 50%, transparent 50%);
      padding: 0 4px;
    }

    .profile-container {
      max-width: 600px;
      margin: 0 auto;
    }

    .profile-item {
      margin-bottom: 12px;
      font-size: 16px;
    }

    .food-img, .character-img {
      width: 200px;
      height: auto;
      margin: 6px auto 12px auto;
      display: block;
    }

    ul {
      margin: 4px 0 0 0;
      padding: 0;
      list-style-position: inside;
    }

    li {
      font-size: 16px;
    }

    .timetable-section {
      margin-top: 24px;
    }

    .timetable-title {
      font-size: 16px;
      font-weight: bold;
      margin-bottom: 8px;
    }

    table {
      border-collapse: collapse;
      width: 280px;
      margin: 6px auto 0 auto;
    }

    th, td {
      border: 1px solid #000000;
      padding: 4px 8px;
      text-align: center;
      font-size: 16px;
      color: #000000;
    }

    th {
      font-weight: bold;
      background-color: #ffffff;
    }

    .comment-section {
      margin-top: 32px;
      padding-top: 16px;
      border-top: none;
    }

    .comment-title {
      font-size: 16px;
      font-weight: bold;
      margin-bottom: 8px;
    }

    .comment-form {
      margin-bottom: 12px;
    }

    .comment-list {
      margin: 8px 0 0 0;
      padding: 0;
      list-style: none;
    }

    .comment-list li {
      margin-bottom: 4px;
    }
  </style>
</head>
<body>

  <h1><span>개인 프로필</span></h1>

  <div class="profile-container">
    <div class="profile-item">
      이름: <%= profile.name %>
    </div>
    <div class="profile-item">
      나이: <%= profile.age %>세
    </div>
    <div class="profile-item">
      학교: <%= profile.school %>
    </div>
    <div class="profile-item">
      학과: <%= profile.department %>
    </div>
    <div class="profile-item">
      거주지: <%= profile.location %>
    </div>
    <div class="profile-item">
      MBTI: INFP
    </div>
    <div class="profile-item">
      이번 학기 목표: 학점 4점 넘기
    </div>
    <div class="profile-item">
      좋아하는 노래: <a href="https://www.youtube.com/watch?v=GKC1P0mCt4o" target="_blank">https://www.youtube.com/watch?v=GKC1P0mCt4o</a>
    </div>
    <div class="profile-item">
      좋아하는 음식: <%= profile.food %>
      <img src="/hamburger.jpg" alt="햄버거 이미지" class="food-img">
    </div>

    <div class="profile-item">
      좋아하는 캐릭터: 커비
      <img src="/kirby.png" alt="커비 이미지" class="character-img">
    </div>

    <div class="profile-item">
      취미:
      <ul>
        <% profile.hobbies.forEach(function(hobby) { %>
          <li><%= hobby %></li>
        <% }); %>
      </ul>
    </div>

    <div class="timetable-section">
      <div class="timetable-title">시간표</div>
      <table>
        <thead>
          <tr>
            <th>요일</th>
            <th>교시</th>
            <th>과목명</th>
          </tr>
        </thead>
        <tbody>
          <% schedule.forEach(function(item) { %>
            <tr>
              <td><%= item.day %></td>
              <td><%= item.time %></td>
              <td><%= item.subject %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="comment-section">
      <div class="comment-title">한 줄 방명록</div>
      
      <div class="comment-form">
        <input type="text" id="nickname" placeholder="작성자 이름" style="width: 100px; padding: 4px;">
        <input type="text" id="commentText" placeholder="댓글을 입력하세요..." style="width: 220px; padding: 4px;">
        <button onclick="addComment()" style="padding: 4px 8px; cursor: pointer;">등록</button>
      </div>

      <ul id="commentList" class="comment-list">
        
      </ul>
    </div>

  </div>

  <script>
    function addComment() {
      const nicknameInput = document.getElementById('nickname');
      const commentInput = document.getElementById('commentText');
      const commentList = document.getElementById('commentList');

      const name = nicknameInput.value.trim();
      const text = commentInput.value.trim();

      if (name === '' || text === '') {
        alert('이름과 댓글 내용을 모두 입력해주세요!');
        return;
      }

      const newLi = document.createElement('li');
      newLi.innerHTML = `<strong>${name}:</strong> ${text}`;
      commentList.appendChild(newLi);

      nicknameInput.value = '';
      commentInput.value = '';
    }
  </script>

</body>
</html>